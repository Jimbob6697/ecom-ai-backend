{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  assign loading = 'lazy'
  if section.index == 1
    assign heading_tag = 'h1'
    assign loading = 'eager'
  endif
-%}
<section class="hero-bold hero-bold--{{ s.height }}">
  <div class="hero-bold__media">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif s.image != blank -%}
      {{ s.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2600, 3000', sizes: '100vw', loading: loading, alt: s.image.alt, style: s.focus }}
    {%- else -%}
      {% render 'art', index: 2, icon: 'leaf' %}
    {%- endif -%}
  </div>
  <div class="page-width hero-bold__content">
    {%- if s.eyebrow != blank -%}
      <p class="hero-bold__eyebrow" data-hero-line style="--i: 0">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <{{ heading_tag }} class="hero-bold__heading">
      {%- if s.heading != blank -%}
        <span data-hero-line style="--i: 1">{{ s.heading | escape }}</span>
      {%- endif -%}
      {%- if s.heading_2 != blank -%}
        <span class="hero-bold__accent" data-hero-line style="--i: 2">{{ s.heading_2 | escape }}</span>
      {%- endif -%}
    </{{ heading_tag }}>
    <div class="hero-bold__foot" data-hero-line style="--i: 3">
      {%- if s.text != blank -%}
        <p class="hero-bold__text">{{ s.text | escape }}</p>
      {%- endif -%}
      <div class="hero-bold__actions">
        {%- if s.button_label != blank -%}
          <a class="button button--large" href="{{ s.button_link | default: s.product.url | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.product != blank -%}
          {% render 'rating', product: s.product %}
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if s.stamp != blank -%}
    <div class="stamp hero-bold__stamp" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <defs><path id="stamp-{{ section.id }}" d="M100 100m-76 0a76 76 0 1 1 152 0a76 76 0 1 1-152 0"/></defs>
        <text><textPath href="#stamp-{{ section.id }}" textLength="470">{{ s.stamp | upcase | escape }}</textPath></text>
      </svg>
      <strong>{{ s.stamp_centre | escape }}</strong>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop in place of the photo." },
    {
      "type": "select",
      "id": "focus",
      "label": "Keep this part of the photo in view",
      "options": [
        { "value": "object-position: center", "label": "Centre" },
        { "value": "object-position: top", "label": "Top" },
        { "value": "object-position: bottom", "label": "Bottom" }
      ],
      "default": "object-position: center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading, first line", "default": "Good hair." },
    { "type": "text", "id": "heading_2", "label": "Heading, second line", "default": "Great stories." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Curl care for textured hair with a life of its own." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop curl cream" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the product below." },
    { "type": "product", "id": "product", "label": "Product", "info": "Shows this product's real review rating beside the button." },
    { "type": "text", "id": "stamp", "label": "Rotating stamp text", "default": "Made in the UK · Light hold · No crunch ·" },
    { "type": "text", "id": "stamp_centre", "label": "Stamp centre", "default": "93% natural" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
