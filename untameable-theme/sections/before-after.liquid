{%- liquid
  assign s = section.settings
  assign has_pair = false
  if s.before != blank and s.after != blank
    assign has_pair = true
  endif
-%}
<section class="section before-after before-after--{{ s.scheme }}">
  <div class="page-width before-after__grid">
    <div class="before-after__copy">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading" data-reveal>{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}
        <div class="before-after__text rte" data-reveal style="--i: 1">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.quote != blank -%}
        <figure class="before-after__quote" data-reveal style="--i: 2">
          {% render 'stars', rating: 5 %}
          <blockquote>{{ s.quote | escape }}</blockquote>
          {%- if s.quote_author != blank -%}
            <figcaption>{{ s.quote_author | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a class="button" href="{{ s.button_link }}" data-reveal style="--i: 3">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="before-after__media" data-reveal>
      {%- if has_pair -%}
        {%- comment -%} Two photos: drag the handle to compare. {%- endcomment -%}
        <div class="compare" data-compare style="--pos: 50%">
          {{ s.after | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: s.after_label, class: 'compare__image' }}
          <div class="compare__before">
            {{ s.before | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: s.before_label, class: 'compare__image' }}
          </div>
          <span class="compare__label compare__label--before">{{ s.before_label | escape }}</span>
          <span class="compare__label compare__label--after">{{ s.after_label | escape }}</span>
          <span class="compare__handle" aria-hidden="true"></span>
          <input class="compare__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-compare-range>
        </div>
      {%- elsif s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: s.image.alt, class: 'before-after__single' }}
      {%- else -%}
        {% render 'art', index: 3, icon: 'star' %}
      {%- endif -%}
      {%- if s.caption != blank -%}
        <p class="before-after__caption">{{ s.caption | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before and after",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Add a Before photo and an After photo for a drag-to-compare slider, or a single ready-made side-by-side image." },
    { "type": "image_picker", "id": "before", "label": "Before photo" },
    { "type": "image_picker", "id": "after", "label": "After photo" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "image_picker", "id": "image", "label": "Or one side-by-side image" },
    { "type": "text", "id": "caption", "label": "Caption", "info": "For example who is pictured, and that results vary." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "See the difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same curls. Better definition." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "quote", "label": "Customer quote", "info": "A real customer's words. Left empty, nothing is shown." },
    { "type": "text", "id": "quote_author", "label": "Customer name" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "accent", "label": "Accent" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "accent"
    }
  ],
  "presets": [{ "name": "Before and after" }]
}
{% endschema %}
