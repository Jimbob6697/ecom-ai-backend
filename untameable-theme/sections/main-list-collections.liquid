<header class="page-hero">
  <div class="page-width page-hero__content">
    <h1 class="page-hero__title" data-hero-line style="--i: 0">{{ section.settings.heading | escape }}</h1>
  </div>
</header>
<section class="section section--tight">
  <div class="page-width">
    {%- paginate collections by 24 -%}
      <ul class="collection-grid" role="list">
        {%- for collection in collections -%}
          <li>
            <a class="collection-card" href="{{ collection.url }}" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
              <div class="collection-card__media">
                {%- if collection.featured_image -%}
                  {{ collection.featured_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'art', index: forloop.index, icon: 'leaf' %}
                {%- endif -%}
              </div>
              <h2 class="collection-card__title">{{ collection.title }}</h2>
              <span class="link-arrow">Shop</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "The collections" }]
}
{% endschema %}
