{%- liquid
  assign s = section.settings
  assign product = s.product
-%}
{%- if product != blank -%}
  <section class="section featured-product featured-product--{{ s.scheme }}" data-product>
    <div class="page-width featured-product__grid">
      <div class="featured-product__media" data-reveal>
        {%- assign shot = s.image | default: product.featured_media -%}
        {%- if shot != blank -%}
          {{ shot | image_url: width: 1800 | image_tag: widths: '500, 800, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: product.title }}
        {%- endif -%}
        {%- if s.sticker != blank -%}
          <span class="sticker" aria-hidden="true">{{ s.sticker | escape }}</span>
        {%- endif -%}
      </div>
      <div class="featured-product__info">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-heading featured-product__title" data-reveal>
          <a href="{{ product.url }}">{{ s.heading | default: product.title | escape }}</a>
        </h2>
        <div data-reveal>{% render 'rating', product: product, link: product.url %}</div>
        {%- if s.text != blank -%}
          <div class="featured-product__text rte" data-reveal style="--i: 1">{{ s.text }}</div>
        {%- endif -%}
        <div data-reveal style="--i: 2">
          {% render 'buy-box', product: product, section_id: section.id, s: s %}
        </div>
        <p class="featured-product__more" data-reveal><a class="link-arrow" href="{{ product.url }}">{{ s.link_label | escape }}</a></p>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section"><div class="page-width"><p>Choose a product in the section settings.</p></div></section>
{%- endif -%}

{% schema %}
{
  "name": "Featured product",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave empty to use the product's first photo." },
    { "type": "text", "id": "sticker", "label": "Sticker text", "info": "A short round badge over the photo, such as “Made in the UK”." },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the product name." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Full details" },
    { "type": "header", "content": "Buying" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": false },
    { "type": "text", "id": "highlight_value", "label": "Pack to highlight", "info": "The pack whose name contains this word gets the flag below.", "default": "Duo" },
    { "type": "text", "id": "highlight_text", "label": "Flag on that pack", "default": "Free UK delivery" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee line" },
    { "type": "url", "id": "guarantee_link", "label": "Guarantee details link" },
    { "type": "text", "id": "chips", "label": "Short claims", "info": "Separate with commas.", "default": "93% natural, Made in the UK, Light hold" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Tinted" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
