<section class="section faq{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading section-heading--center" data-reveal data-split>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="accordion" data-reveal>
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            {{ block.settings.question | escape }}
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it work on fine hair?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. The formula is lightweight, so start with a small amount and build from there.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>See our delivery page for current prices and times.</p>" } }]
    }
  ]
}
{% endschema %}
