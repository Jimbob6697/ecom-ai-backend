{%- capture marquee_items -%}
  {%- for block in section.blocks -%}
    <span class="marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
    <span class="marquee__dot" aria-hidden="true">{% render 'icon', name: 'leaf' %}</span>
  {%- endfor -%}
{%- endcapture -%}
<section class="marquee marquee--{{ section.settings.scheme }}" style="--marquee-speed: {{ section.settings.speed }}s">
  <div class="marquee__track">
    <div class="marquee__group">{{ marquee_items }}{{ marquee_items }}</div>
    <div class="marquee__group" aria-hidden="true">{{ marquee_items }}{{ marquee_items }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Scrolling text",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40 },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Grey" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "93% natural" }]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [{ "type": "text" }, { "type": "text", "settings": { "text": "Made in the UK" } }]
    }
  ]
}
{% endschema %}
