    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Every dog is different, so please check the measurements on each product before ordering. If you need a hand, email <a href=\"mailto:info@dogbarnyorkshire.com\">info@dogbarnyorkshire.com</a> or message @dogbarn.yorkshire on Instagram and we'll help.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How much is delivery, and how long does it take?",
            "answer": "<p>UK Standard delivery (2–4 working days) is £2.95, and free when you spend over £50 on dog accessories. UK Tracked Express (24–48 hours) is £5.95 — order by 1pm, Monday to Friday. Standard orders are dispatched within 1–3 working days with Royal Mail.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you deliver outside the UK?",
            "answer": "<p>Yes. European delivery takes 3–5 working days and international delivery 5–15 working days, both £6.95. Customs fees may apply in your country.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I return or exchange an item?",
            "answer": "<p>Yes — items returned in perfect condition, free from pet hair and in their original packaging can be refunded or exchanged. Personalised items are non-refundable. See <a href=\"/pages/delivery-returns\">Delivery & Returns</a> for the full details.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How should I wash my dog's fleece?",
            "answer": "<p>We recommend hand washing, or a delicate wash at no more than 30 degrees.</p>"
          }
        }
      },
