<header class="page-hero">
  <div class="page-width page-hero__content">
    <h1 class="page-hero__title" data-hero-line style="--i: 0">{{ blog.title }}</h1>
  </div>
</header>
<section class="section section--tight">
  <div class="page-width">
    {%- paginate blog.articles by 12 -%}
      <ul class="collection-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a class="article-card" href="{{ article.url }}" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
              <div class="article-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'art', index: forloop.index %}
                {%- endif -%}
              </div>
              <p class="eyebrow">{{ article.published_at | date: '%-d %B %Y' }}</p>
              <h2 class="article-card__title">{{ article.title }}</h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
