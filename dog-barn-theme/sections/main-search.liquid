<header class="page-hero">
  <div class="page-width page-hero__content">
    <h1 class="page-hero__title" data-hero-line style="--i: 0">
      {%- if search.performed -%}
        {{ 'search.results_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'general.search' | t }}
      {%- endif -%}
    </h1>
    <form class="search-form search-form--page" action="{{ routes.search_url }}" method="get" role="search" data-hero-line style="--i: 1">
      {% render 'icon', name: 'search' %}
      <input
        class="search-form__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
      >
    </form>
  </div>
</header>

<section class="section section--tight">
  <div class="page-width">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count == 0 -%}
          <div class="empty-state">
            <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
            <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
          </div>
        {%- else -%}
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {%- assign card_index = forloop.index0 | modulo: 4 -%}
              {% render 'product-card', product: item, index: card_index %}
                {%- else -%}
                  <article class="text-card" data-reveal>
                    <a href="{{ item.url }}">
                      <p class="eyebrow">{{ item.object_type | capitalize }}</p>
                      <h3>{{ item.title }}</h3>
                      <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                    </a>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results"
}
{% endschema %}
