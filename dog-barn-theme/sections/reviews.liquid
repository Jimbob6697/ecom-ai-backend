{%- liquid
  assign s = section.settings
  assign filled = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
<section class="section reviews reviews--{{ s.scheme }}">
  <div class="page-width reviews__header">
    <div>
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading" data-reveal>
        {{ s.heading | escape }}
        {%- if s.subheading != blank %} <span>{{ s.subheading | escape }}</span>{% endif -%}
      </h2>
    </div>
    {%- if settings.review_score != blank -%}
      <div class="reviews__score" data-reveal style="--i: 1">
        <p class="reviews__number">{{ settings.review_score | escape }}</p>
        <div>
          {% render 'stars', rating: settings.review_score %}
          <p class="reviews__label">
            <strong>{{ settings.review_label | escape }}</strong>
            {%- if settings.review_count != blank %} · {{ settings.review_count | escape }}{% endif -%}
          </p>
          {%- if settings.review_url != blank -%}
            <a class="link-arrow" href="{{ settings.review_url }}" target="_blank" rel="noopener">Read all on {{ settings.review_source | default: 'our review page' | escape }}</a>
          {%- elsif settings.review_source != blank -%}
            <p class="reviews__source">on {{ settings.review_source | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if filled > 0 or request.design_mode -%}
    <div class="scroller" data-scroller>
      <ul class="scroller__track reviews__track" role="list" data-scroller-track>
        {%- for block in section.blocks -%}
          {%- if block.type != 'review' -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign b = block.settings
            assign review_product = b.product
          -%}
          {%- if b.text != blank -%}
            <li class="reviews__item" data-reveal style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
              <figure class="review-card">
                {%- if b.image != blank -%}
                  <div class="review-card__photo">
                    {{ b.image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '340px', loading: 'lazy', alt: b.image.alt }}
                  </div>
                {%- endif -%}
                <div class="review-card__body">
                  {% render 'stars', rating: b.rating %}
                  {%- if b.title != blank -%}
                    <p class="review-card__title">{{ b.title | escape }}</p>
                  {%- endif -%}
                  <blockquote class="review-card__text">{{ b.text | escape }}</blockquote>
                  <figcaption class="review-card__author">
                    <strong>{{ b.author | escape }}</strong>
                    {%- if b.verified -%}
                      <span class="review-card__verified">{% render 'icon', name: 'check' %}Verified buyer</span>
                    {%- endif -%}
                    {%- if b.detail != blank -%}
                      <span class="review-card__detail">{{ b.detail | escape }}</span>
                    {%- endif -%}
                  </figcaption>
                </div>
                {%- if review_product != blank -%}
                  <a class="review-card__product" href="{{ review_product.url }}">
                    {%- if review_product.featured_media -%}
                      {{ review_product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span>{{ review_product.title }}</span>
                    {% render 'icon', name: 'arrow-right' %}
                  </a>
                {%- endif -%}
              </figure>
            </li>
          {%- elsif request.design_mode -%}
            <li class="reviews__item" {{ block.shopify_attributes }}>
              <figure class="review-card review-card--empty">
                <div class="review-card__body">
                  {% render 'stars', rating: 5 %}
                  <p class="review-card__text">Paste a real customer review into this block. Empty review blocks are only visible here in the editor, never on your live store.</p>
                </div>
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="scroller__nav page-width">
        <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="page-width reviews__app">{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "paragraph", "content": "The score comes from Theme settings → Reviews and trust. Add review blocks by pasting real reviews, or add your review app's widget as an app block." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by dogs, trusted by owners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "subheading", "label": "Heading (italic part)" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Stone" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "textarea", "id": "text", "label": "Review", "info": "Paste the customer's own words. Blocks left empty are not shown on the live store." },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "e.g. the dog's breed, or the date." },
        { "type": "checkbox", "id": "verified", "label": "Show “Verified buyer”", "info": "Only tick this for reviews collected through a verified-purchase review platform.", "default": false },
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "product", "id": "product", "label": "Product reviewed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
