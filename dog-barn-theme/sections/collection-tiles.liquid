<section class="section collection-tiles{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading" data-reveal data-split>
        {{ section.settings.heading | escape }}
        {%- if section.settings.subheading != blank %} <span>{{ section.settings.subheading | escape }}</span>{% endif -%}
      </h2>
    </div>
  </div>
  <div class="scroller" data-scroller>
    <ul class="scroller__track collection-tiles__track" role="list" data-scroller-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_url = block.settings.link | default: tile_collection.url | default: routes.collections_url
          assign tile_image = block.settings.image | default: tile_collection.featured_image | default: tile_collection.products.first.featured_media
          assign tile_title = block.settings.title | default: tile_collection.title | default: 'Collection'
        -%}
        <li class="collection-tiles__item" data-reveal style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <a class="collection-tile" href="{{ tile_url }}">
            <div class="collection-tile__media">
              {%- if tile_image != blank -%}
                {{ tile_image | image_url: width: 1000 | image_tag: widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 990px) 22vw, 60vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'art', index: forloop.index, icon: 'paw' %}
              {%- endif -%}
            </div>
            <span class="collection-tile__label">
              <span class="collection-tile__title">{{ tile_title | escape }}</span>
              <span class="collection-tile__cta">{% render 'icon', name: 'arrow-right' %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="scroller__nav page-width">
      <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Heading (italic part)" },
    { "type": "checkbox", "id": "surface", "label": "Stone background", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection name." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image, or its first product photo." },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
