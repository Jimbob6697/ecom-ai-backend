{%- liquid
  assign s = section.settings
  assign filled = 0
  for block in section.blocks
    if block.settings.video != blank or block.settings.poster != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<section class="section ugc ugc--{{ s.scheme }}" data-ugc>
  <div class="page-width ugc__header">
    <div>
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading" data-reveal data-split>
        {{ s.heading | escape }}
        {%- if s.subheading != blank %} <span>{{ s.subheading | escape }}</span>{% endif -%}
      </h2>
      {%- if s.text != blank -%}
        <p class="ugc__text" data-reveal style="--i: 1">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>
    <div class="ugc__social" data-reveal style="--i: 2">
      {%- if settings.social_instagram != blank -%}
        <a class="button button--outline button--small" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        <a class="button button--outline button--small" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
      {%- endif -%}
    </div>
  </div>

  <div class="scroller" data-scroller>
    <ul class="scroller__track ugc__track" role="list" data-scroller-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign ugc_product = b.product
          assign ugc_label = b.handle | default: 'our customer'
          if b.video == blank and b.poster == blank
            unless request.design_mode
              continue
            endunless
          endif
        -%}
        <li class="ugc__item" data-reveal style="--i: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <article class="ugc-card" data-ugc-card>
            <button class="ugc-card__open" type="button" data-ugc-open="{{ forloop.index0 }}" aria-label="{% if b.video != blank %}Play video{% else %}View photo{% endif %} from {{ ugc_label | escape }}">
              <span class="ugc-card__media">
                {%- if b.video != blank -%}
                  {{ b.video | video_tag: image_size: '600x', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', class: 'ugc-card__video' }}
                {%- elsif b.poster != blank -%}
                  {{ b.poster | image_url: width: 700 | image_tag: widths: '300, 450, 700', sizes: '(min-width: 990px) 260px, 60vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'art', index: forloop.index, icon: 'play' %}
                {%- endif -%}
              </span>
              {%- if b.video != blank -%}
                <span class="ugc-card__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
              {%- endif -%}
              <span class="ugc-card__meta">
                {%- if b.handle != blank -%}
                  <span class="ugc-card__handle">{{ b.handle | escape }}</span>
                {%- endif -%}
                {%- if b.caption != blank -%}
                  <span class="ugc-card__caption">{{ b.caption | escape }}</span>
                {%- endif -%}
              </span>
            </button>
            {%- if ugc_product != blank -%}
              <a class="ugc-card__product" href="{{ ugc_product.url }}" data-ugc-product>
                {%- if ugc_product.featured_media -%}
                  {{ ugc_product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
                <span>
                  <strong>{{ ugc_product.title }}</strong>
                  {{ ugc_product.price | money }}
                </span>
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          </article>
        </li>
      {%- endfor -%}
    </ul>
    <div class="scroller__nav page-width">
      <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>

  <dialog class="ugc-viewer" data-ugc-viewer aria-label="Customer videos">
    <div class="ugc-viewer__frame">
      <div class="ugc-viewer__progress" aria-hidden="true"><span data-ugc-progress></span></div>
      <div class="ugc-viewer__stage" data-ugc-stage></div>
      <p class="ugc-viewer__meta" data-ugc-meta></p>
      <div class="ugc-viewer__product" data-ugc-cta></div>
      <button class="ugc-viewer__close" type="button" data-ugc-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      <button class="ugc-viewer__mute" type="button" data-ugc-mute aria-label="Toggle sound" aria-pressed="false">
        {% render 'icon', name: 'sound' %}
      </button>
    </div>
    <button class="ugc-viewer__nav ugc-viewer__nav--prev" type="button" data-ugc-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
    <button class="ugc-viewer__nav ugc-viewer__nav--next" type="button" data-ugc-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
  </dialog>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Customer videos",
  "max_blocks": 16,
  "settings": [
    { "type": "paragraph", "content": "Upload short vertical clips (9:16) from customers, Instagram Reels or TikTok. Clips play silently as they scroll into view and open full screen with sound when tapped." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@dogbarn.yorkshire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spotted on the walk" },
    { "type": "text", "id": "subheading", "label": "Heading (italic part)" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tag us to be featured. Real dogs, real adventures." },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Stone" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Vertical 9:16, ideally under 30 seconds." },
        { "type": "image_picker", "id": "poster", "label": "Photo", "info": "Shown if no video is added." },
        { "type": "text", "id": "handle", "label": "Handle or name", "info": "e.g. @bertie.the.cavapoochon" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "product", "id": "product", "label": "Product worn", "info": "Adds a “shop the look” link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer videos",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
