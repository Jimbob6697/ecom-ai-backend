<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'site-footer__logo site-header__logo-image--dark', alt: shop.name }}
        {%- else -%}
          <p class="site-footer__wordmark">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        {% render 'review-summary' %}
        <ul class="site-footer__social" role="list">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
        </ul>
      </div>

      <div class="site-footer__columns">
        {%- for block in section.blocks -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- assign block_menu = block.settings.menu -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | default: block_menu.title | escape }}</h2>
                <ul role="list">
                  {%- for link in block_menu.links limit: block.settings.limit -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                <div class="rte">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.notes != blank -%}
      <div class="site-footer__notes rte">{{ section.settings.notes }}</div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <p class="site-footer__giant" aria-hidden="true">{{ shop.name }}</p>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <ul class="site-footer__legal" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment -%}
        <ul class="site-footer__payment" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "A cream or white logo file is shown in black automatically." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "For the stylish & adventurous pup." },
    { "type": "richtext", "id": "notes", "label": "Small print" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show oversized shop name", "default": false },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the menu name." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "range", "id": "limit", "label": "Maximum links", "min": 3, "max": 16, "step": 1, "default": 8 }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Need a hand with sizing?" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Email us and we'll help you find the right fit.</p>" }
      ]
    }
  ]
}
{% endschema %}
