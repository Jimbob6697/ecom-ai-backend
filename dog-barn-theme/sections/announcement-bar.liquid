{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="Announcements" data-announcement>
    <div class="page-width announcement__inner">
      <div class="announcement__messages">
        {%- for block in section.blocks -%}
          <p class="announcement__message{% if forloop.first %} is-active{% endif %}" data-announcement-item {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_reviews -%}
        {% render 'review-summary', class: 'announcement__reviews' %}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "show_reviews", "label": "Show review score on desktop", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on orders over £50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
