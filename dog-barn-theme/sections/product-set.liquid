{%- comment -%}
  "Complete the set": other pieces in the same colourway as the product being
  viewed, each with a one-tap add. The colourway is the collection whose name
  the product title starts with (for example "Chestnut Trail"). A collection
  chosen in the section settings overrides that.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign set_collection = s.collection
  assign set_name = set_collection.title
  if set_collection == blank
    for candidate in product.collections
      assign candidate_name = candidate.title | remove: ' Collection' | strip
      assign title_start = product.title | slice: 0, candidate_name.size
      if candidate_name.size > 4 and title_start == candidate_name
        assign set_collection = candidate
        assign set_name = candidate_name
        break
      endif
    endfor
  endif

  assign others = 0
  for item in set_collection.products limit: 20
    if item.id != product.id
      assign others = others | plus: 1
    endif
  endfor
-%}
{%- if set_collection != blank and others > 0 -%}
  <section class="section product-shelf product-set{% if s.surface %} section--surface{% endif %}">
    <div class="page-width product-shelf__header">
      <div>
        <h2 class="section-heading" data-reveal>
          {{ s.heading | escape }}
          {%- if s.show_name and set_name != blank %} <span>in {{ set_name | escape }}</span>{% endif -%}
        </h2>
        {%- if s.text != blank -%}
          <p class="product-set__text" data-reveal>{{ s.text | escape }}</p>
        {%- endif -%}
      </div>
      <a class="link-arrow" href="{{ set_collection.url }}" data-reveal>View all</a>
    </div>

    <div class="scroller" data-scroller>
      <ul class="scroller__track product-shelf__track" role="list" data-scroller-track>
        {%- assign shown = 0 -%}
        {%- for item in set_collection.products limit: 20 -%}
          {%- if item.id == product.id or shown >= s.limit -%}
            {%- continue -%}
          {%- endif -%}
          <li class="product-shelf__item">
            {% render 'product-card', product: item, index: shown, sizes: '(min-width: 990px) 320px, 62vw', quick_add: true %}
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </ul>
      <div class="scroller__nav page-width">
        <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Complete the set",
  "settings": [
    { "type": "paragraph", "content": "Shows the other pieces in the same colourway as the product, each with a one-tap add. It finds the colourway from the product's collections automatically, and hides itself when there is no match." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the set" },
    { "type": "checkbox", "id": "show_name", "label": "Add the colourway name to the heading", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Matching pieces in the same colourway." },
    { "type": "collection", "id": "collection", "label": "Always use this collection", "info": "Optional. Overrides the automatic colourway match." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": true }
  ],
  "presets": [{ "name": "Complete the set" }]
}
{% endschema %}
