{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}
<header class="page-hero{% if collection.image != blank and section.settings.show_image %} page-hero--image{% endif %}">
  {%- if collection.image != blank and section.settings.show_image -%}
    <div class="page-hero__media" data-parallax>
      {{ collection.image | image_url: width: 2600 | image_tag: widths: '750, 1100, 1500, 2000, 2600', sizes: '100vw', loading: 'eager', alt: '' }}
    </div>
  {%- endif -%}
  <div class="page-width page-hero__content">
    <h1 class="page-hero__title" data-hero-line style="--i: 0">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="page-hero__text rte" data-hero-line style="--i: 1">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</header>

<section class="section section--tight collection">
  <div class="page-width">
    {%- paginate collection.products by section.settings.per_page -%}
      <form class="toolbar" action="{{ collection.url }}" method="get" data-filter-form>
        <div class="toolbar__bar">
          <p class="toolbar__count">{{ 'collections.count' | t: count: collection.products_count }}</p>
          <div class="toolbar__actions">
            {%- if collection.filters.size > 0 -%}
              <button class="toolbar__toggle" type="button" aria-expanded="false" aria-controls="filters-{{ section.id }}" data-filter-toggle>
                {% render 'icon', name: 'filter' %}
                {{ 'collections.filter' | t }}
                {%- if active_count > 0 %} <span class="toolbar__badge">{{ active_count }}</span>{% endif -%}
              </button>
            {%- endif -%}
            <label class="select">
              <span class="visually-hidden">{{ 'collections.sort' | t }}</span>
              <select name="sort_by" data-submit-on-change>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'chevron-down' %}
            </label>
          </div>
        </div>

        {%- if collection.filters.size > 0 -%}
          <div class="filters" id="filters-{{ section.id }}" data-filters hidden>
            <div class="filters__grid">
              {%- for filter in collection.filters -%}
                <fieldset class="filter">
                  <legend class="filter__label">{{ filter.label | escape }}</legend>
                  {%- case filter.type -%}
                    {%- when 'list', 'boolean' -%}
                      <ul class="filter__values" role="list">
                        {%- for value in filter.values -%}
                          <li>
                            <label class="check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}
                                  checked
                                {% endif %}
                                {% if value.count == 0 and value.active == false %}
                                  disabled
                                {% endif %}
                              >
                              <span>{{ value.label | escape }} <small>({{ value.count }})</small></span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      <div class="filter__price">
                        <label>
                          <span>{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="0"
                            min="0"
                            aria-label="Minimum price"
                            {%- if filter.min_value.value -%}
                              value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                            {%- endif -%}
                          >
                        </label>
                        <span>to</span>
                        <label>
                          <span>{{ cart.currency.symbol }}</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                            min="0"
                            aria-label="Maximum price"
                            {%- if filter.max_value.value -%}
                              value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                            {%- endif -%}
                          >
                        </label>
                      </div>
                  {%- endcase -%}
                </fieldset>
              {%- endfor -%}
            </div>
            <div class="filters__actions">
              <button class="button button--small" type="submit">{{ 'collections.apply' | t }}</button>
              {%- if active_count > 0 -%}
                <a class="link-arrow" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </form>

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li>{%- assign card_index = forloop.index0 | modulo: 4 -%}
              {% render 'product-card', product: product, index: card_index %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.empty' | t }}</p>
          <a class="button" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image behind the title", "default": true }
  ]
}
{% endschema %}
