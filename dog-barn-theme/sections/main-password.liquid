<section class="hero hero--full hero--align-center password">
  <div class="hero__media">{% render 'art', index: 2, icon: 'paw' %}</div>
  <div class="hero__content page-width"><div class="hero__inner">
    <p class="eyebrow hero__eyebrow" data-hero-line style="--i: 0">{{ shop.name }}</p>
    <h1 class="hero__heading" data-hero-line style="--i: 1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="hero__subheading" data-hero-line style="--i: 2">{{ shop.password_message }}</p>
    {%- endif -%}
    <div class="password__forms" data-hero-line style="--i: 3">
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="input-pill">
            <input type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" aria-label="{{ 'newsletter.label' | t }}" autocomplete="email" required>
            <button class="button" type="submit">Notify me</button>
          </div>
        {%- endif -%}
      {%- endform -%}
      <details class="password__details">
        <summary>{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter__form' -%}
          <div class="input-pill">
            <input type="password" name="password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}" autocomplete="current-password">
            <button class="button" type="submit">{{ 'password.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endform -%}
      </details>
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }]
}
{% endschema %}
