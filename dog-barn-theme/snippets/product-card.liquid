{%- comment -%}
  Product card used in shelves, grids, search and recommendations.
  Usage: {% render 'product-card', product: product, index: forloop.index, sizes: '...' %}
  Pass nil as the product to render a placeholder card.
{%- endcomment -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign badge = ''
  assign badge_class = ''
  if product != blank
    assign now_s = 'now' | date: '%s' | plus: 0
    assign published_s = product.published_at | date: '%s' | plus: 0
    assign age_days = now_s | minus: published_s | divided_by: 86400
    if product.available == false
      assign badge = 'products.sold_out' | t
      assign badge_class = 'badge--muted'
    elsif product.compare_at_price > product.price
      assign badge = 'products.sale' | t
      assign badge_class = 'badge--sale'
    elsif age_days < 30
      assign badge = 'products.new' | t
    endif
  endif
-%}
<article class="product-card" data-reveal style="--i: {{ index | default: 0 }}">
  <a class="product-card__link" href="{{ product.url | default: '#' }}">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 1000
          | image_tag: widths: '300, 450, 600, 800, 1000', sizes: card_sizes, loading: 'lazy', class: 'product-card__image', alt: product.featured_media.alt
        }}
        {%- if settings.card_second_image and product.media[1] -%}
          {{
            product.media[1]
            | image_url: width: 1000
            | image_tag: widths: '300, 450, 600, 800, 1000', sizes: card_sizes, loading: 'lazy', class: 'product-card__image product-card__image--hover', alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {% render 'art', index: index, icon: 'paw' %}
      {%- endif -%}
      {%- if badge != blank -%}
        <span class="badge {{ badge_class }}">{{ badge }}</span>
      {%- endif -%}
      <span class="product-card__view" aria-hidden="true">{{ 'products.view' | t }}</span>
    </div>
    <div class="product-card__info">
      {%- if settings.card_show_type and product.type != blank -%}
        <p class="product-card__type">{{ product.type }}</p>
      {%- endif -%}
      <h3 class="product-card__title">{{ product.title | default: 'Your product name' }}</h3>
      <p class="product-card__price">
        {%- if product != blank -%}
          {% render 'price', product: product, show_from: true %}
        {%- else -%}
          {{ 2900 | money }}
        {%- endif -%}
      </p>
    </div>
  </a>
</article>
