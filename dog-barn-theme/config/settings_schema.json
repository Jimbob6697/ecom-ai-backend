      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#425563",
        "info": "Brand Midnight."
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6f6259",
        "info": "Brand Bark."
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Buttons",
        "default": "#425563",
        "info": "Brand Midnight."
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark sections",
        "default": "#425563",
        "info": "Brand Midnight."
      },
      {
        "type": "color",
        "id": "color_on_dark",
        "label": "Text on dark sections, footer and accent sections",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_announcement",
        "label": "Announcement bar",
        "default": "#d2ccbe",
        "info": "Brand Beige."
      },
      {
        "type": "color",
        "id": "color_footer",
        "label": "Footer",
        "default": "#6f6259",
        "info": "Brand Bark."
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Accent sections",
        "default": "#6f755c",
        "info": "Brand Lawn."
      },
      {
        "type": "color",
        "id": "color_brass",
        "label": "Review stars",
        "default": "#6f755c",
        "info": "Brand Lawn."
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price and “New” label",
        "default": "#6f755c",
        "info": "Brand Lawn."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "type_builtin",
        "label": "Use the brand fonts",
        "info": "Headings in Big Caslon, labels and buttons in Nord, text in Poppins Light.",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "Big Caslon and Nord are licensed fonts, so the theme ships with close stand-ins (Libre Caslon Display and Lexend Giga). To show the real fonts, upload your licensed web font files (.woff2) under Content → Files and paste each file's URL below."
      },
      {
        "type": "text",
        "id": "font_heading_url",
        "label": "Big Caslon Medium file URL",
        "info": "Used for headings."
      },
      {
        "type": "text",
        "id": "font_label_url",
        "label": "Nord Medium file URL",
        "info": "Used for labels, buttons and small capitals."
      },
      {
        "type": "header",
        "content": "Or choose other fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "alegreya_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "josefin_sans_n4"
      }
    ]
  },
  {
    "name": "Layout and motion",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 980,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1600
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "animations_page",
        "label": "Smooth transitions between pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "animations_hover",
        "label": "Hover effects on cards",
        "default": true
      }
    ]
  },
  {
    "name": "Reviews and trust",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shown in the header bar, trust strip, reviews section and product pages. Keep these in line with your live review profile."
      },
      {
        "type": "text",
        "id": "review_score",
        "label": "Review score",
        "default": "4.9"
      },
      {
        "type": "text",
        "id": "review_label",
        "label": "Score label",
        "default": "Excellent"
      },
      {
        "type": "text",
        "id": "review_count",
        "label": "Number of reviews",
        "info": "Optional, e.g. “312 reviews”."
      },
      {
        "type": "text",
        "id": "review_source",
        "label": "Review platform",
        "default": "Trustpilot"
      },
      {
        "type": "url",
        "id": "review_url",
        "label": "Link to your review profile"
      },
      {
        "type": "text",
        "id": "pay_later_text",
        "label": "Pay-later message",
        "info": "Shown under the price on product pages. Leave empty to hide.",
        "default": "Pay in 3 interest-free payments with Klarna."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_type",
        "label": "Show product type",
        "default": false
      },
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "1",
            "label": "Square"
          },
          {
            "value": "0.8",
            "label": "Portrait"
          }
        ],
        "default": "1"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Allow order notes",
        "default": false
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold",
        "info": "In your store currency. Set to 0 to hide the progress bar.",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 50
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/dogbarn.yorkshire"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL",
        "default": "https://www.tiktok.com/@dogbarnyorkshire"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Scaled down to 32 × 32px"
      }
    ]
  }
]
