[
  {
    "name": "theme_info",
    "theme_name": "Dog Barn Yorkshire",
    "theme_version": "1.0.0",
    "theme_author": "In House",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#f7f3ec"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Alternate background",
        "default": "#ece5d8"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1b201d"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6a6f69"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Buttons",
        "default": "#1b201d"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Announcement bar, footer and dark sections",
        "default": "#1f2e26"
      },
      {
        "type": "color",
        "id": "color_on_dark",
        "label": "Text on dark sections",
        "default": "#f4eee2"
      },
      {
        "type": "color",
        "id": "color_brass",
        "label": "Stars and fine details",
        "default": "#a98652"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#9b3d2e"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "type_builtin",
        "label": "Use the theme's own fonts",
        "info": "Cormorant Garamond for headings and Jost for text, bundled with the theme. Untick to choose fonts below.",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "alegreya_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "josefin_sans_n4"
      }
    ]
  },
  {
    "name": "Layout and motion",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 980,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "animations_page",
        "label": "Smooth transitions between pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "animations_hover",
        "label": "Hover effects on cards",
        "default": true
      }
    ]
  },
  {
    "name": "Reviews and trust",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shown in the header bar, trust strip, reviews section and product pages. Keep these in line with your live review profile."
      },
      {
        "type": "text",
        "id": "review_score",
        "label": "Review score",
        "default": "4.9"
      },
      {
        "type": "text",
        "id": "review_label",
        "label": "Score label",
        "default": "Excellent"
      },
      {
        "type": "text",
        "id": "review_count",
        "label": "Number of reviews",
        "info": "Optional, e.g. “312 reviews”."
      },
      {
        "type": "text",
        "id": "review_source",
        "label": "Review platform",
        "default": "Trustpilot"
      },
      {
        "type": "url",
        "id": "review_url",
        "label": "Link to your review profile"
      },
      {
        "type": "text",
        "id": "pay_later_text",
        "label": "Pay-later message",
        "info": "Shown under the price on product pages. Leave empty to hide.",
        "default": "Pay in 3 interest-free payments with Klarna."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_type",
        "label": "Show product type",
        "default": true
      },
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "1",
            "label": "Square"
          },
          {
            "value": "0.8",
            "label": "Portrait"
          }
        ],
        "default": "0.8"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Allow order notes",
        "default": false
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold",
        "info": "In your store currency. Set to 0 to hide the progress bar.",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 50
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/dogbarn.yorkshire"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL",
        "default": "https://www.tiktok.com/@dogbarnyorkshire"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Scaled down to 32 × 32px"
      }
    ]
  }
]
