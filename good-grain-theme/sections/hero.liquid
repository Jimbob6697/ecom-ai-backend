{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
  assign duo = false
  if s.image_2 != blank
    assign duo = true
  endif
  if s.video != blank
    assign duo = false
  endif
-%}
<section class="hero hero--{{ s.height }} hero--{{ s.position }}{% if duo %} hero--duo{% endif %}" data-scroll-fx>
  <div class="hero__media">
    <div class="hero__panel">
      {%- if s.video != blank -%}
        {{ s.video | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {%- elsif s.image != blank -%}
        {%- liquid
          assign hero_sizes = '100vw'
          if duo
            assign hero_sizes = '(min-width: 750px) 50vw, 100vw'
          endif
          assign hero_loading = 'lazy'
          if section.index == 1
            assign hero_loading = 'eager'
          endif
        -%}
        {{ s.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2600, 3000', sizes: hero_sizes, loading: hero_loading, alt: s.image.alt }}
      {%- else -%}
        {% render 'art', index: 2, icon: 'leaf' %}
      {%- endif -%}
    </div>
    {%- if duo -%}
      <div class="hero__panel hero__panel--second">
        {{ s.image_2 | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '50vw', loading: 'lazy', alt: s.image_2.alt }}
      </div>
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    {%- if s.eyebrow != blank -%}
      <p class="hero__eyebrow" data-hero-line style="--i: 0">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="hero__heading" data-hero-line style="--i: 1">{{ s.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="hero__subheading" data-hero-line style="--i: 2">{{ s.subheading | escape }}</p>
    {%- endif -%}
    {%- if s.button_label != blank or s.link_label != blank -%}
      <div class="hero__actions" data-hero-line style="--i: 3">
        {%- if s.button_label != blank -%}
          <a class="button button--ghost" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="button button--ghost" href="{{ s.link_link | default: routes.collections_url }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.show_reviews -%}
      <div class="hero__reviews" data-hero-line style="--i: 4">{% render 'review-summary' %}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Decadent taste, vibrant nutrition" },
    { "type": "text", "id": "subheading", "label": "Text", "default": "100% natural overnight oats for a fast breakfast, with slow-release energy." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Second button label" },
    { "type": "url", "id": "link_link", "label": "Second button link" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show review score", "default": false },
    { "type": "header", "content": "Imagery" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Fills the full width of the screen." },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "Optional. On larger screens the two images sit side by side, edge to edge — ideal for square photos." },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop in place of the images." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text position",
      "options": [
        { "value": "bottom", "label": "Bottom centre" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "bottom"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
