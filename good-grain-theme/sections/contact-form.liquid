<section class="section section--tight contact">
  <div class="page-width page-width--narrow" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading section-heading--center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'contact.success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact__row">
        <label class="field">
          <span>{{ 'contact.name' | t }}</span>
          <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
        </label>
        <label class="field">
          <span>{{ 'contact.email' | t }}</span>
          <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | default: customer.email }}">
        </label>
      </div>
      <label class="field">
        <span>Order number (optional)</span>
        <input type="text" name="contact[order_number]" placeholder="If your message is about an order">
      </label>
      <label class="field">
        <span>{{ 'contact.message' | t }}</span>
        <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </label>
      <button class="button button--large" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
