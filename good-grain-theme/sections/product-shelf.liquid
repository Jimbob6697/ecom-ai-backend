{%- liquid
  assign shelf_collection = section.settings.collection | default: collections.all
  assign limit = section.settings.limit
-%}
<section class="section product-shelf{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width product-shelf__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading" data-reveal data-split>
        {{ section.settings.heading | escape }}
        {%- if section.settings.subheading != blank %} <span>{{ section.settings.subheading | escape }}</span>{% endif -%}
      </h2>
    </div>
    {%- if section.settings.show_view_all -%}
      <a class="link-arrow" href="{{ shelf_collection.url | default: routes.all_products_collection_url }}" data-reveal>View all</a>
    {%- endif -%}
  </div>

  <div class="scroller" data-scroller>
    <ul class="scroller__track product-shelf__track" role="list" data-scroller-track>
      {%- for product in shelf_collection.products limit: limit -%}
        <li class="product-shelf__item">
          {% render 'product-card', product: product, index: forloop.index0, sizes: '(min-width: 990px) 320px, 62vw' %}
        </li>
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="product-shelf__item">
            {% render 'product-card', product: nil, index: forloop.index0 %}
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
    <div class="scroller__nav page-width">
      <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product shelf",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The latest" },
    { "type": "text", "id": "subheading", "label": "Heading (muted part)", "default": "arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Shows all products until a collection is chosen." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” link", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": true }
  ],
  "presets": [{ "name": "Product shelf" }]
}
{% endschema %}
