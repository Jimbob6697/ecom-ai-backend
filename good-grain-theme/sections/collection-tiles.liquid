<section class="collection-tiles">
  {%- if section.settings.heading != blank -%}
    <div class="page-width collection-tiles__header">
      <h2 class="section-label" data-reveal>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}
  <ul class="collection-tiles__grid collection-tiles__grid--{{ section.settings.columns }}" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign tile_url = block.settings.link | default: tile_collection.url | default: routes.collections_url
        assign tile_image = block.settings.image | default: tile_collection.featured_image | default: tile_collection.products.first.featured_media
        assign tile_title = block.settings.title | default: tile_collection.title | default: 'Collection'
      -%}
      <li class="collection-tiles__item" {{ block.shopify_attributes }}>
        <a class="collection-tile" href="{{ tile_url }}">
          <div class="collection-tile__media" data-reveal="fade">
            {%- if tile_image != blank -%}
              {{ tile_image | image_url: width: 2000 | image_tag: widths: '500, 800, 1100, 1500, 2000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'art', index: forloop.index, icon: 'leaf' %}
            {%- endif -%}
          </div>
          <span class="collection-tile__title">{{ tile_title | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Category grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Small label", "info": "Optional." },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection name." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image, or its first product photo." },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
