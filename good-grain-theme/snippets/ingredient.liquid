{%- comment -%}
  A small illustrated ingredient. Usage: {% render 'ingredient', name: 'oat' %}
  Names: oat, chia, date, cashew, cacao, vanilla, maple, peanut, banana, cinnamon, berry, coffee, pistachio, coconut
{%- endcomment -%}
<svg class="ingredient ingredient--{{ name }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'chia' -%}
      <ellipse cx="14" cy="16" rx="5" ry="3.6" fill="#2e2a2b" transform="rotate(-20 14 16)"/>
      <ellipse cx="32" cy="12" rx="4.4" ry="3.2" fill="#4a4245" transform="rotate(25 32 12)"/>
      <ellipse cx="24" cy="28" rx="5.2" ry="3.8" fill="#1f1c1d" transform="rotate(10 24 28)"/>
      <ellipse cx="38" cy="32" rx="4.2" ry="3" fill="#57504f" transform="rotate(-35 38 32)"/>
      <ellipse cx="11" cy="36" rx="4.4" ry="3.2" fill="#3a3435" transform="rotate(40 11 36)"/>
    {%- when 'date' -%}
      <ellipse cx="24" cy="24" rx="13" ry="20" fill="#6b3421" transform="rotate(28 24 24)"/>
      <path d="M17 12c-3 8-2 17 4 25" fill="none" stroke="#8d4b2f" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M26 9c5 6 7 14 5 24" fill="none" stroke="#4d2416" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'cashew' -%}
      <path d="M12 14c-6 9-2 24 12 26 11 1 18-8 15-16-2-4-7-4-9 0-2 5-7 5-9 0-1-4 1-8-2-11-2-2-5-2-7 1z" fill="#ecd3a2"/>
      <path d="M16 20c-1 7 3 13 10 14" fill="none" stroke="#d3b47c" stroke-width="2" stroke-linecap="round"/>
    {%- when 'cacao' -%}
      <path d="M8 18l14-10 16 6 4 16-12 10-16-4z" fill="#3b2019"/>
      <path d="M8 18l15 6 15-10M23 24l-1 16" fill="none" stroke="#5a3327" stroke-width="1.8" stroke-linejoin="round"/>
    {%- when 'vanilla' -%}
      <g fill="#fff6dc" stroke="#e8d59b" stroke-width="1.2">
        <ellipse cx="24" cy="11" rx="5" ry="9"/>
        <ellipse cx="24" cy="11" rx="5" ry="9" transform="rotate(72 24 24)"/>
        <ellipse cx="24" cy="11" rx="5" ry="9" transform="rotate(144 24 24)"/>
        <ellipse cx="24" cy="11" rx="5" ry="9" transform="rotate(216 24 24)"/>
        <ellipse cx="24" cy="11" rx="5" ry="9" transform="rotate(288 24 24)"/>
      </g>
      <circle cx="24" cy="24" r="4.5" fill="#e9b949"/>
    {%- when 'maple' -%}
      <path d="M24 4c8 11 14 18 14 26a14 14 0 0 1-28 0c0-8 6-15 14-26z" fill="#c9792b"/>
      <path d="M17 29a7 7 0 0 0 6 8" fill="none" stroke="#f0b56a" stroke-width="2.4" stroke-linecap="round"/>
    {%- when 'peanut' -%}
      <path d="M17 6c7-3 14 3 13 10-1 4-3 6-2 9 2 5 6 8 4 14-3 8-15 8-18 1-3-6 1-10 2-15 1-4-3-7-3-12 0-3 2-6 4-7z" fill="#d9a55f"/>
      <path d="M16 12c3 2 7 2 10 0M14 22c4 2 9 2 12 0M15 33c4 2 9 2 13 0" fill="none" stroke="#b98241" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'banana' -%}
      <circle cx="24" cy="24" r="18" fill="#f6e3a1"/>
      <circle cx="24" cy="24" r="18" fill="none" stroke="#e7c95f" stroke-width="2.5"/>
      <circle cx="24" cy="24" r="6" fill="none" stroke="#e2c986" stroke-width="1.6"/>
      <circle cx="21" cy="22" r="1.3" fill="#7b5a2c"/><circle cx="27" cy="23" r="1.3" fill="#7b5a2c"/><circle cx="24" cy="27" r="1.3" fill="#7b5a2c"/>
    {%- when 'cinnamon' -%}
      <rect x="18" y="3" width="12" height="42" rx="6" fill="#a2542a" transform="rotate(24 24 24)"/>
      <path d="M17 10l14 28" stroke="#7a3b1a" stroke-width="2" stroke-linecap="round"/>
      <path d="M22 8l14 28" stroke="#c57541" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'berry' -%}
      <path d="M24 44C12 38 6 28 8 19c2-7 9-9 16-6 7-3 14-1 16 6 2 9-4 19-16 25z" fill="#e2434b"/>
      <path d="M14 10c4-5 8-5 10 0 2-5 6-5 10 0-4 3-6 4-10 3-4 1-6 0-10-3z" fill="#3f8f4f"/>
      <g fill="#f8c9a8"><circle cx="17" cy="23" r="1.2"/><circle cx="25" cy="21" r="1.2"/><circle cx="32" cy="24" r="1.2"/><circle cx="21" cy="31" r="1.2"/><circle cx="29" cy="32" r="1.2"/></g>
    {%- when 'coffee' -%}
      <ellipse cx="24" cy="24" rx="13" ry="19" fill="#4a2a1c" transform="rotate(-25 24 24)"/>
      <path d="M17 9c8 6 2 20 13 30" fill="none" stroke="#2a150d" stroke-width="2.4" stroke-linecap="round"/>
    {%- when 'pistachio' -%}
      <ellipse cx="24" cy="24" rx="12" ry="19" fill="#e6d3b0" transform="rotate(20 24 24)"/>
      <ellipse cx="25" cy="24" rx="7" ry="15" fill="#9dbb6c" transform="rotate(20 25 24)"/>
      <path d="M22 12c-2 8-1 16 4 24" fill="none" stroke="#7da04e" stroke-width="1.6" stroke-linecap="round"/>
    {%- when 'coconut' -%}
      <path d="M6 20a18 18 0 0 0 36 0z" fill="#fffaf0" stroke="#7a5236" stroke-width="4" stroke-linejoin="round"/>
      <path d="M14 26c5 4 15 4 20 0" fill="none" stroke="#eadfca" stroke-width="2" stroke-linecap="round"/>
    {%- else -%}
      <ellipse cx="24" cy="24" rx="13" ry="20" fill="#ead9b5" transform="rotate(-18 24 24)"/>
      <path d="M18 8c4 10 6 22 12 32" fill="none" stroke="#cdb685" stroke-width="2" stroke-linecap="round"/>
      <path d="M14 20c5-1 9 0 13 3M17 30c5-2 9-1 13 2" fill="none" stroke="#d8c498" stroke-width="1.4" stroke-linecap="round"/>
  {%- endcase -%}
</svg>
