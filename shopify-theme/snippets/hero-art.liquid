{%- comment -%}
  Animated line drawing used by the hero until an image or video is added.
  A generic electric saloon silhouette — not a depiction of any specific vehicle.
{%- endcomment -%}
<div class="hero-art" aria-hidden="true">
  <span class="hero-art__aurora"></span>
  <svg class="hero-art__car" viewBox="0 0 1200 380" fill="none" preserveAspectRatio="xMidYMax meet">
    <defs>
      <linearGradient id="hero-art-stroke" x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" stop-opacity=".15"/>
        <stop offset=".45" stop-color="#fff" stop-opacity=".95"/>
        <stop offset="1" stop-color="#fff" stop-opacity=".35"/>
      </linearGradient>
      <linearGradient id="hero-art-ground" x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" stop-opacity="0"/>
        <stop offset=".5" stop-color="#fff" stop-opacity=".5"/>
        <stop offset="1" stop-color="#fff" stop-opacity="0"/>
      </linearGradient>
      <radialGradient id="hero-art-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="var(--color-accent)" stop-opacity=".7"/>
        <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <ellipse class="hero-art__glow" cx="600" cy="332" rx="520" ry="34" fill="url(#hero-art-glow)"/>
    <g stroke="url(#hero-art-stroke)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path class="hero-art__line" pathLength="1" d="M150 300c-14-22-8-58 24-74 86-26 196-98 346-106 104-4 186 12 262 62 86 12 204 20 262 54 26 14 30 44 12 64H950a70 70 0 0 0-140 0H400a70 70 0 0 0-140 0Z"/>
      <path class="hero-art__line hero-art__line--2" pathLength="1" d="M292 216c70-52 152-76 232-78 92-2 164 14 226 54ZM540 139l8 66"/>
      <path class="hero-art__line hero-art__line--3" pathLength="1" d="M1004 240l44 14M160 236l30-8M420 262h370"/>
      <circle class="hero-art__line hero-art__line--3" pathLength="1" cx="880" cy="300" r="52"/>
      <circle class="hero-art__line hero-art__line--3" pathLength="1" cx="330" cy="300" r="52"/>
      <circle class="hero-art__line hero-art__line--4" pathLength="1" cx="880" cy="300" r="26"/>
      <circle class="hero-art__line hero-art__line--4" pathLength="1" cx="330" cy="300" r="26"/>
    </g>
    <path class="hero-art__ground" d="M0 353h1200" stroke="url(#hero-art-ground)" stroke-width="1"/>
  </svg>
</div>
