<section class="section statement statement--{{ section.settings.scheme }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <p class="statement__text" data-word-reveal>{{ section.settings.text | escape }}</p>
    {%- if section.settings.link_label != blank -%}
      <a class="link-arrow statement__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-reveal>
        {{- section.settings.link_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Scrolling statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Words light up one by one as the visitor scrolls.",
      "default": "Every accessory is measured against the real car, tested through a British winter and backed for life. If it doesn't fit like it came from the factory, we take it back."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our fit guarantee" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "dark"
    }
  ],
  "presets": [{ "name": "Scrolling statement" }]
}
{% endschema %}
