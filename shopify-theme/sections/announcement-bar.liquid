{%- if section.settings.text != blank -%}
  <div class="announcement{% if section.settings.dark %} announcement--dark{% endif %}" role="region" aria-label="Announcement">
    <p class="page-width">
      {{ section.settings.text | escape }}
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on orders over £50." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "dark", "label": "Dark style", "default": false }
  ]
}
{% endschema %}
