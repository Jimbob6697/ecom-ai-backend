<section class="section newsletter newsletter--{{ section.settings.scheme }}">
  <div class="page-width page-width--narrow newsletter__inner" data-reveal>
    <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'newsletter.success' | t }}
        </p>
      {%- else -%}
        <div class="input-pill">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.label' | t }}"
            aria-label="{{ 'newsletter.label' | t }}"
            autocomplete="email"
            required
          >
          <button class="button" type="submit">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first to know." },
    { "type": "text", "id": "text", "label": "Text", "default": "New releases, fitting guides and owner-only offers. No spam." },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Grey" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
