<section class="section section--tight value-props{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <ul class="value-props__list" role="list">
      {%- for block in section.blocks -%}
        <li class="value-prop" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="value-prop__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="value-prop__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="value-prop__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="link-arrow" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "settings": [{ "type": "checkbox", "id": "surface", "label": "Grey background", "default": false }],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Shield" },
            { "value": "chat", "label": "Chat" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On UK orders over £50." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [{ "type": "prop" }, { "type": "prop", "settings": { "icon": "return", "title": "30-day returns", "text": "Changed your mind? Send it back." } }, { "type": "prop", "settings": { "icon": "chat", "title": "Expert help", "text": "Real owners, real answers." } }]
    }
  ]
}
{% endschema %}
