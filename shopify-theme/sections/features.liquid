<section class="section features{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" data-reveal>
        {{ section.settings.heading | escape }}
        {%- if section.settings.subheading != blank %} <span>{{ section.settings.subheading | escape }}</span>{% endif -%}
      </h2>
    {%- endif -%}
    <div class="features__grid">
      {%- for block in section.blocks -%}
        <article
          class="feature-card feature-card--{{ block.settings.size }}{% if block.settings.dark %} feature-card--dark{% endif %}"
          data-reveal
          style="--i: {{ forloop.index0 | modulo: 3 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="feature-card__media">
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '500, 800, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt }}
            </div>
          {%- endif -%}
          <div class="feature-card__body">
            {%- if block.settings.stat != blank -%}
              <p class="feature-card__stat" data-count-up>{{ block.settings.stat | escape }}</p>
            {%- else -%}
              <span class="feature-card__icon">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <h3 class="feature-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="feature-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature grid",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why drivers choose us." },
    { "type": "text", "id": "subheading", "label": "Heading (muted part)", "default": "Even more reasons to shop with us." },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "stat", "label": "Big number", "info": "Optional, e.g. “0.5mm”. Replaces the icon and counts up when scrolled into view." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "car", "label": "Car" },
            { "value": "shield", "label": "Shield" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "chat", "label": "Chat" }
          ],
          "default": "ruler"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Precision fit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Laser-measured against the real car for a factory finish." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "size",
          "label": "Width",
          "options": [
            { "value": "third", "label": "One third" },
            { "value": "half", "label": "Half" },
            { "value": "two-thirds", "label": "Two thirds" },
            { "value": "full", "label": "Full" }
          ],
          "default": "third"
        },
        { "type": "checkbox", "id": "dark", "label": "Dark card", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
