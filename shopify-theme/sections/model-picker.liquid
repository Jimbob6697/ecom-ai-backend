<section class="section model-picker{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" data-reveal>
        {{ section.settings.heading | escape }}
        {%- if section.settings.subheading != blank %} <span>{{ section.settings.subheading | escape }}</span>{% endif -%}
      </h2>
    {%- endif -%}
  </div>
  <div class="scroller" data-scroller>
    <ul class="scroller__track model-picker__track" role="list" data-scroller-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_collection = block.settings.collection
          assign block_url = block.settings.link | default: block_collection.url | default: routes.all_products_collection_url
          assign block_image = block.settings.image | default: block_collection.featured_image
        -%}
        <li class="model-picker__item" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <a class="model-tile" href="{{ block_url }}">
            <div class="model-tile__media">
              {%- if block_image != blank -%}
                {{ block_image | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 220px, 40vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'art', index: forloop.index, icon: 'car' %}
              {%- endif -%}
            </div>
            <span class="model-tile__title">{{ block.settings.title | default: block_collection.title | escape }}</span>
            {%- if block.settings.caption != blank -%}
              <span class="model-tile__caption">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="scroller__nav page-width">
      <button class="scroller__button" type="button" data-scroller-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      <button class="scroller__button" type="button" data-scroller-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by model",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by model." },
    { "type": "text", "id": "subheading", "label": "Heading (muted part)", "default": "Find the perfect fit." },
    { "type": "checkbox", "id": "surface", "label": "Grey background", "default": false }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Model",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Model Y" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square image, ideally on a transparent or light grey background." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by model",
      "blocks": [
        { "type": "model", "settings": { "title": "Model 3" } },
        { "type": "model", "settings": { "title": "Model Y" } },
        { "type": "model", "settings": { "title": "Model S" } },
        { "type": "model", "settings": { "title": "Model X" } },
        { "type": "model", "settings": { "title": "Cybertruck" } }
      ]
    }
  ]
}
{% endschema %}
