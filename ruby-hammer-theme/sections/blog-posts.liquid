{%- liquid
  assign s = section.settings
  assign blog = s.blog
-%}
{%- if blog != blank and blog.articles_count > 0 -%}
  <section class="section blog-posts{% if s.surface %} section--surface{% endif %}">
    <div class="page-width">
      <div class="section-intro">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-heading" data-reveal>{{ s.heading | escape }}</h2>
      </div>
      <ul class="blog-posts__grid" role="list">
        {%- for article in blog.articles limit: s.limit -%}
          <li data-reveal style="--i: {{ forloop.index0 }}">
            <a class="article-card" href="{{ article.url }}">
              {%- if article.image -%}
                <div class="article-card__media">
                  {{ article.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt }}
                </div>
              {%- endif -%}
              <h3 class="article-card__title">{{ article.title }}</h3>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <span class="link-arrow">{{ s.link_label | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.view_all_label != blank -%}
        <p class="blog-posts__all"><a class="button button--outline" href="{{ blog.url }}">{{ s.view_all_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "div",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mini masterclasses" },
    { "type": "range", "id": "limit", "label": "Posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Post link label", "default": "Read more" },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "View all articles" },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
