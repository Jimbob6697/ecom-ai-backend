<header class="page-hero">
  <div class="page-width page-width--narrow page-hero__content">
    <h1 class="page-hero__title" data-hero-line style="--i: 0">{{ page.title }}</h1>
  </div>
</header>
<section class="section section--tight">
  <div class="page-width page-width--narrow rte" data-reveal>
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
