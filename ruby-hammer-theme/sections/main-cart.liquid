<section class="section cart-page">
  <form class="page-width cart-page__inner" action="{{ routes.cart_url }}" method="post" data-cart-content data-cart-section="{{ section.id }}" data-item-count="{{ cart.item_count }}">
    {%- if cart.item_count > 0 -%}
      <header class="cart-page__header">
        <h1 class="cart-page__title">
          {%- assign total = cart.total_price | money -%}
          Your bag total is {{ total }}.
        </h1>
        <p class="cart-page__sub">{{ 'cart.taxes' | t }}</p>
      </header>
      <div class="cart-page__grid">
        <div class="cart-page__items">{% render 'cart-items', cart: cart %}</div>
        <div class="cart-page__summary">{% render 'cart-summary', cart: cart, context: 'page' %}</div>
      </div>
    {%- else -%}
      <div class="empty-state empty-state--large">
        <h1 class="cart-page__title">{{ 'cart.empty' | t }}</h1>
        <a class="button button--large" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </form>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
